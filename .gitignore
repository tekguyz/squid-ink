.env*
.DS_Store
.worktrees/
# Harness-created worktrees. Each holds a full second copy of the repo, so an
# accidental `git add .` would commit the whole tree into itself.
.claude/worktrees/

# Claude Design canvas runtime — read-only tooling, not part of this app
design-reference/support.js

# The .env* rule above would otherwise swallow the committed example file.
!.env.local.example

# Audio pulled out of Storage for manual QA (docs/qa/recorder-manual-test-protocol.md).
*.bin
*.webm
*.m4a

# Speech fixture generated by scripts/verify-transcription-pipeline.mjs. The
# script deletes it in a finally block; this covers a hard crash. Named, not
# `*.wav`, so a real audio fixture added later is not silently swallowed.
scratch-verify-transcription.wav

# Dev server output redirected during live verification.
dev-server.log

