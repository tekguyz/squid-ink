# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# Read the real values with:
#   npx supabase projects api-keys --project-ref <project-ref> --reveal

# Browser-safe. Next.js sends every NEXT_PUBLIC_ var to the client.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only. Bypasses RLS entirely.
# No application code reads this — it is used solely by scripts/verify-rls.mjs
# to create the two test auth users. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Fixtures for scripts/verify-rls.mjs only. Not used by the app.
RLS_TEST_OWNER_EMAIL=squid-ink-owner@example.test
RLS_TEST_OWNER_PASSWORD=<generated>
RLS_TEST_INTRUDER_EMAIL=squid-ink-intruder@example.test
RLS_TEST_INTRUDER_PASSWORD=<generated>

# Server-only. Gates app/api/cron/transcribe — an unauthenticated request must
# never be able to spend the Gemini key. Vercel sends this as an
# `Authorization: Bearer <value>` header on every cron invocation. Any random
# string of 32+ characters; there is nothing to sign up for.
CRON_SECRET=<32+ random characters>

# Server-only. Billed Google AI Studio key for gemini-3.5-transcribe.
GEMINI_API_KEY=<key>
